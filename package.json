{
  "name": "postmail",
  "version": "1.0.0",
  "private": true,
  "description": "Gmail email open tracking",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "cd packages/shared && npx tsc",
    "build:extension": "cd apps/extension && npx webpack",
    "build": "npm run build:shared && npm run build:extension",
    "test": "npm run test --workspaces --if-present",
    "test:extension": "cd apps/extension && npx jest",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
