# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=postmail
POSTGRES_PASSWORD=postmail_dev
POSTGRES_DB=postmail
POSTGRES_PORT=5432
DATABASE_URL=postgres://postmail:postmail_dev@localhost:5432/postmail

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3006/oauth/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# ─── Service Ports ────────────────────────────────────────
API_PORT=3005
DASHBOARD_PORT=3006
API_URL=http://localhost:3005
DASHBOARD_URL=http://localhost:3006

# ─── Gmail Mailbox OAuth (separate app for inbox access) ─
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:3006/gmail/callback

# ─── Microsoft/Outlook OAuth ─────────────────────────────
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3006/outlook/callback
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id

# ─── Future: Tracking ────────────────────────────────────
# TRACKING_DOMAIN=https://track.yourdomain.com

# ─── Future: Discord Notifications ───────────────────────
# DISCORD_WEBHOOK_URL=
