# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=postmail
POSTGRES_PASSWORD=postmail_dev
POSTGRES_DB=postmail
POSTGRES_PORT=5432
DATABASE_URL=postgres://postmail:postmail_dev@localhost:5432/postmail

# ─── Supabase (Dashboard Login) ──────────────────────────
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Service Ports ────────────────────────────────────────
API_PORT=3001
DASHBOARD_PORT=5173
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173

# ─── Future: Gmail Mailbox OAuth (NOT Supabase) ──────────
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=

# ─── Future: Microsoft/Outlook OAuth ─────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── Future: Tracking ────────────────────────────────────
# TRACKING_DOMAIN=https://track.yourdomain.com

# ─── Future: Discord Notifications ───────────────────────
# DISCORD_WEBHOOK_URL=
