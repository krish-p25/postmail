{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "./dist",
    // Application, not a library: no .d.ts output (also avoids TS4058 on inferred generic helpers)
    "declaration": false,
    "paths": {
      "@postmail/shared": ["../../packages/shared/src"],
      "@postmail/shared/*": ["../../packages/shared/src/*"]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/**", "src/test/**"]
}
